# ===========================================
# FREP Backend Environment Variables
# ===========================================
# Copy this file to .env for local development.

# Server Configuration
SERVER_PORT=8080

# Spring Profiles (oracle for Oracle DB connection)
SPRING_PROFILES_ACTIVE=oracle

# AWS Cognito (FAM) — leave blank to run without auth.
# AWS_COGNITO_ISSUER_URI=https://cognito-idp.ca-central-1.amazonaws.com/YOUR_USER_POOL_ID
AWS_COGNITO_ISSUER_URI=
# COGNITO_USERINFO_URI=https://your-domain.auth.ca-central-1.amazoncognito.com/oauth2/userInfo
COGNITO_USERINFO_URI=

# Optional: identity lookup service base URL (kept blank disables it).
IDENTITY_LOOKUP_BASE_URL=

# Legacy Oracle (required for backend startup — same env vars as nr-fspts).
# DATABASE_HOST=your-oracle-host.apps.silver.devops.gov.bc.ca
# DATABASE_PORT=1543
# DATABASE_SERVICE_NAME=your_service_name
# DATABASE_USER=your_frep_db_user
# DATABASE_PASSWORD=your_frep_db_password
# TRUSTSTORE_PATH=/absolute/path/to/jssecacerts
# KEYSTORE_SECRET=your_truststore_password

# Frontend CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000

# Logging
LOGGING_LEVEL=INFO
