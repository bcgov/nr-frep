# Listen only on high ports (3000, 3001, 3003).
{
	metrics
	auto_https off
	admin 0.0.0.0:3003
	order coraza_waf first
}
:3000 {
	log {
		output stdout
		format console
		level {$LOG_LEVEL}
	}

	# Enable Coraza WAF
	coraza_waf {
		directives `
		Include /etc/caddy/coraza.conf
		`
	}

	root * /srv
	encode zstd gzip
	file_server
	@spa_router {
		not path /api*
		not path /health
		file {
			try_files {path} /index.html
		}
	}
	rewrite @spa_router {http.matchers.file.relative}
	# Connectivity probe target for the frontend (see src/hooks/useOnlineStatus.ts). Must be excluded
	# from @spa_router above, or try_files rewrites it to /index.html before `respond` ever runs, and
	# the probe pays for the whole app shell instead of two bytes. `respond` is ordered ahead of
	# file_server, so this wins without a handle block. The site-wide no-store Cache-Control below
	# keeps intermediaries from answering it from cache.
	respond /health "OK" 200
	# Proxy requests to API service
	reverse_proxy /api* {$BACKEND_URL} {
		header_up Host {http.reverse_proxy.upstream.hostport}
		header_up X-Real-IP {remote_host}
	}
	header {
		-Server
		X-Frame-Options "SAMEORIGIN"
		Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate"
		X-Content-Type-Options "nosniff"
		Strict-Transport-Security "max-age=31536000"
		# The host list below is derived from what this app actually loads, not inherited. Verified
		# against src/ on 2026-09-10 — so it is deliberately tighter than the near-identical policy in
		# sibling repos, which still permit fonts.googleapis.com, use.fontawesome.com and www.w3.org
		# that nothing here requests.
		#
		#   img-src     *.gov.bc.ca is LOAD-BEARING — OpeningMap renders WMS overlays straight from
		#               openmaps.gov.bc.ca (see components/OpeningMap/mapLayers.ts); the two tile
		#               hosts back the OSM and ArcGIS base layers; blob: backs attachment previews.
		#   connect-src *.gov.bc.ca is the BC Gov SSO realm — discovery, token and JWKS.
		#   style-src   'unsafe-inline' stays: Carbon injects <style> at runtime.
		#   base-uri    stated explicitly because it does NOT fall back to default-src, so without
		#               this line it is unset and an injected <base> can re-point every relative URL.
		#
		# Removed as deprecated: X-XSS-Protection (the legacy auditor introduced vulnerabilities of
		# its own) and block-all-mixed-content (superseded; HSTS above covers the intent).
		Content-Security-Policy "default-src 'self';
			script-src 'self';
			style-src 'self' 'unsafe-inline';
			font-src 'self';
			img-src 'self' data: blob: https://*.gov.bc.ca https://*.tile.openstreetmap.org https://server.arcgisonline.com;
			connect-src 'self' https://*.gov.bc.ca;
			frame-ancestors 'self';
			form-action 'self';
			base-uri 'self';
			object-src 'none';"
		Referrer-Policy "same-origin"
		Permissions-Policy "fullscreen=(self), camera=(), microphone=()"
		Cross-Origin-Resource-Policy "cross-origin"
		Cross-Origin-Opener-Policy "same-origin"
	}
}
:3001 {
	handle /health {
		respond "OK"
	}
}
