# ===========================================
# FREP Backend Environment Variables
# ===========================================
# Copy this file to .env for local development.

# Server Configuration
SERVER_PORT=8080

# Spring Profiles. Oracle is wired in unconditionally (no `oracle` profile). For local dev,
# `local` loads application-local.yml (gitignored credentials); leave blank otherwise.
SPRING_PROFILES_ACTIVE=local

# BC Gov SSO (Keycloak, standard realm). Two values, and only two: oidc-client-ts and the resource
# server derive every endpoint from the issuer. The frontend reads the SAME pair under its own names
# (VITE_KEYCLOAK_URL / VITE_KEYCLOAK_CLIENT_ID) — the env var names differ because Vite only exposes
# VITE_*, but the values must be identical or the SPA gets a token the API refuses.
# KEYCLOAK_ISSUER_URI=https://dev.loginproxy.gov.bc.ca/auth/realms/standard
KEYCLOAK_ISSUER_URI=
# The CSS integration's client id, validated as the token's `azp`.
KEYCLOAK_CLIENT_ID=

# nr-user-lookup-api — the shared BC Gov IDIR directory that resolves evaluator names. Replaces the
# old FAM identity-lookup integration. Calls authenticate with FREP's OWN client_credentials service
# account, not the caller's token.
#
# NOTE THE REALM: the service account lives in the *forests* realm, so USER_LOOKUP_TOKEN_URL is NOT
# derived from KEYCLOAK_ISSUER_URI (the standard realm above). Two similar-looking issuers, different
# values — pointing at the wrong one sends valid credentials to a realm that has never heard of them.
#
# Set ALL of token-url / client-id / client-secret, or none — a partial trio fails fast at startup.
# All blank means an empty directory, and userids display unresolved.
USER_LOOKUP_BASE_URL=
USER_LOOKUP_TOKEN_URL=
USER_LOOKUP_CLIENT_ID=
USER_LOOKUP_CLIENT_SECRET=

# Legacy Oracle (required for backend startup).
# DATABASE_HOST=your-oracle-host.apps.gold.devops.gov.bc.ca
# DATABASE_PORT=1543
# DATABASE_SERVICE_NAME=your_service_name
# DATABASE_USER=your_frep_db_user
# DATABASE_PASSWORD=your_frep_db_password
# TRUSTSTORE_PATH=/absolute/path/to/jssecacerts
# KEYSTORE_SECRET=your_truststore_password

# CHR attachment object storage (S3-compatible) — used for Cultural Heritage
# photo upload/download. Leave blank to disable.
# OBJECT_STORAGE_HOST=https://your-s3-endpoint
# OBJECT_STORAGE_BUCKET=your-bucket-name
# OBJECT_STORAGE_ACCESS_KEY=your-access-key
# OBJECT_STORAGE_SECRET_KEY=your-secret-key

# BC Gov DataBC WFS base URL, proxied for the in-app Leaflet map (opening polygon GeoJSON).
# Public endpoint; the built-in default is production-correct, so this only needs setting to override.
# OPENMAPS_URL=https://openmaps.gov.bc.ca/geo/ows

# Frontend CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000

# Logging
LOGGING_LEVEL=INFO
