# ===========================================
# FREP Backend Environment Variables
# ===========================================
# Copy this file to .env for local development.

# Server Configuration
SERVER_PORT=8080

# Spring Profiles (oracle for Oracle DB connection — optional locally)
# SPRING_PROFILES_ACTIVE=oracle

# LOCAL DEV: Cognito variables not required while auth is disabled.
# AWS_COGNITO_ISSUER_URI=https://cognito-idp.ca-central-1.amazonaws.com/YOUR_USER_POOL_ID
# COGNITO_USERINFO_URI=
# IDENTITY_LOOKUP_BASE_URL=

# Frontend CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000

# Logging
LOGGING_LEVEL=INFO
