# ===========================================
# FREP Frontend Environment Variables
# ===========================================
# Copy this file to .env for local development.

# Application
VITE_APP_NAME=FREP IMS
VITE_ZONE=dev

# Base Path (for deployments behind proxy, e.g., /pub/frep)
VITE_BASE_PATH=

# AWS Cognito (FAM) — required to authenticate against IDIR.
VITE_USER_POOLS_ID=ca-central-1_XXXXXXXXX
VITE_USER_POOLS_WEB_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
# Cognito user pool domain. Defaults to the FAM prod pool if blank.
# VITE_COGNITO_DOMAIN=lza-prod-fam-user-pool-domain.auth.ca-central-1.amazoncognito.com
# Absolute URL to redirect to on sign-out; defaults to the current origin.
# VITE_REDIRECT_SIGN_OUT=http://localhost:3000/

# Leave empty to route /api through the Vite dev-server proxy.
VITE_BACKEND_URL=

# Development Server
VITE_DEV_HOST=localhost
VITE_DEV_PORT=3000
VITE_DEV_BACKEND_TARGET=http://localhost:8080
VITE_HMR_HOST=localhost
VITE_HMR_PORT=3000
VITE_HMR_PROTOCOL=ws

NODE_ENV=development
