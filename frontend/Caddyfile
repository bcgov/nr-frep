# Listen only on high ports (3000, 3001, 3003).
{
	metrics
	auto_https off
	admin 0.0.0.0:3003
	order coraza_waf first
}
:3000 {
	log {
		output stdout
		format console
		level {$LOG_LEVEL}
	}

	# Enable Coraza WAF
	coraza_waf {
		directives `
		Include /etc/caddy/coraza.conf
		`
	}

	root * /srv
	encode zstd gzip
	file_server
	@spa_router {
		not path /api*
		not path /health
		file {
			try_files {path} /index.html
		}
	}
	rewrite @spa_router {http.matchers.file.relative}
	# Connectivity probe target for the frontend (see src/hooks/useOnlineStatus.ts). Must be excluded
	# from @spa_router above, or try_files rewrites it to /index.html before `respond` ever runs, and
	# the probe pays for the whole app shell instead of two bytes. `respond` is ordered ahead of
	# file_server, so this wins without a handle block. The site-wide no-store Cache-Control below
	# keeps intermediaries from answering it from cache.
	respond /health "OK" 200
	# Proxy requests to API service
	reverse_proxy /api* {$BACKEND_URL} {
		header_up Host {http.reverse_proxy.upstream.hostport}
		header_up X-Real-IP {remote_host}
	}
	header {
		-Server
		X-Frame-Options "SAMEORIGIN"
		X-XSS-Protection "1;mode=block"
		Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate"
		X-Content-Type-Options "nosniff"
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self' https://*.gov.bc.ca;
			script-src 'self'  https://*.gov.bc.ca ;
			style-src 'self' https://fonts.googleapis.com https://use.fontawesome.com 'unsafe-inline';
			font-src 'self' https://fonts.gstatic.com;
			img-src 'self' data: blob: https://fonts.googleapis.com https://www.w3.org https://*.gov.bc.ca https://*.tile.openstreetmap.org https://server.arcgisonline.com;
			frame-ancestors 'self';
			form-action 'self';
			block-all-mixed-content;
			connect-src 'self' https://*.gov.bc.ca wss://*.gov.bc.ca;"
		Referrer-Policy "same-origin"
		Permissions-Policy "fullscreen=(self), camera=(), microphone=()"
		Cross-Origin-Resource-Policy "cross-origin"
		Cross-Origin-Opener-Policy "same-origin"
	}
}
:3001 {
	handle /health {
		respond "OK"
	}
}
