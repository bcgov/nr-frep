# ===========================================
# FREP Frontend Environment Variables
# ===========================================
# Copy this file to .env for local development.

# Application
VITE_ZONE=dev

# File types accepted as attachments — SLR attachments AND CHR photos read this one list.
# REQUIRED: there is no in-code default. Deployments set it from the ATTACHMENT_ALLOWED_TYPES GitHub
# variable. This mirrors the value set in GitHub.
VITE_ATTACHMENT_TYPES=BMP,CSV,DOC,DOCX,GIF,JPEG,JPG,MP4,PDF,PNG,RTF,TIF,TIFF,TXT,WEBP,XLS,XLSX,ZIP

# Shared mailbox behind the side nav's "Report an issue" link. Optional — leave it empty and the
# link is hidden. Deployments set it from the SUPPORT_EMAIL GitHub variable.
VITE_SUPPORT_EMAIL=

# Base Path (for deployments behind proxy, e.g., /pub/frep)
VITE_BASE_PATH=

# AWS Cognito (FAM) — required to authenticate against IDIR.
VITE_USER_POOLS_ID=ca-central-1_XXXXXXXXX
VITE_USER_POOLS_WEB_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
# Cognito user pool domain. Defaults to the FAM prod pool if blank.
# VITE_COGNITO_DOMAIN=lza-prod-fam-user-pool-domain.auth.ca-central-1.amazoncognito.com

# Federated logout chain (Siteminder → Keycloak → Cognito → app). Clears the upstream IDIR/Keycloak/
# Cognito SSO session — not just local tokens — so a subsequent login re-prompts for credentials. All
# three are required to enable it; if any is blank, logout falls back to Amplify's sign-out above.
# TEST hosts shown; PROD drops the "test"/"7" (logon7 / loginproxy).
# VITE_LOGOUT_SITEMINDER_URL=https://logontest7.gov.bc.ca/clp-cgi/logoff.cgi
# VITE_LOGOUT_KEYCLOAK_URL=https://test.loginproxy.gov.bc.ca/auth/realms/standard/protocol/openid-connect/logout
# VITE_LOGOUT_KEYCLOAK_CLIENT_ID=<the FAM Keycloak client id for FREP>

# Leave empty to route /api through the Vite dev-server proxy.
VITE_BACKEND_URL=

# Development Server
VITE_DEV_HOST=localhost
VITE_DEV_PORT=3000
VITE_DEV_BACKEND_TARGET=http://localhost:8080
VITE_HMR_HOST=localhost
VITE_HMR_PORT=3000
VITE_HMR_PROTOCOL=ws

NODE_ENV=development
