# ===========================================
# FREP Frontend Environment Variables
# ===========================================
# Copy this file to .env for local development.

# Application. Purely a display label now — the Keycloak IdP hint (azureidir) is the same constant in
# every environment, so numeric PR-preview zones are harmless. Under Cognito this selected the
# identity provider (DEV-IDIR / TEST-IDIR), which is why PR zones had to be remapped.
VITE_ZONE=dev

# Shared mailbox behind the side nav's "Report an issue" link. Optional — leave it empty and the
# link is hidden. Deployments set it from the SUPPORT_EMAIL GitHub variable.
VITE_SUPPORT_EMAIL=

# Mailbox for the landing page's "Request access" link — a different address from the support
# mailbox above. Empty hides the link. Deployments set it from the ACCESS_REQUEST_EMAIL GitHub
# variable.
VITE_ACCESS_REQUEST_EMAIL=

# Base Path (for deployments behind proxy, e.g., /pub/frep)
VITE_BASE_PATH=

# BC Gov SSO (Keycloak, standard realm) — required to authenticate against IDIR.
#
# TWO values, and only two. oidc-client-ts reads the realm's .well-known/openid-configuration and
# discovers the authorize, token, JWKS and end-session endpoints from it, so there is nothing else to
# configure — in particular there is no logout URL here. (The Cognito setup needed three of those,
# hand-chained through Siteminder; they were deleted, not renamed. If you find yourself adding an
# endpoint variable, the discovery document already has it.)
#
# The backend reads the SAME two values under KEYCLOAK_ISSUER_URI / KEYCLOAK_CLIENT_ID. The names
# differ because Vite only exposes VITE_*; the values must not. A mismatch fails AFTER a successful
# sign-in — issuer drift means the SPA holds a token from one realm while the API validates against
# another; client-id drift means the API's azp check refuses every token. Either reads as a 401 storm
# that looks like a permissions problem.
VITE_KEYCLOAK_URL=https://dev.loginproxy.gov.bc.ca/auth/realms/standard
VITE_KEYCLOAK_CLIENT_ID=<the CSS integration's client id>

# Leave empty to route /api through the Vite dev-server proxy.
VITE_BACKEND_URL=

# Development Server
VITE_DEV_HOST=localhost
VITE_DEV_PORT=3000
VITE_DEV_BACKEND_TARGET=http://localhost:8080
VITE_HMR_HOST=localhost
VITE_HMR_PORT=3000
VITE_HMR_PROTOCOL=ws

NODE_ENV=development
