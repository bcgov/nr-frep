# ===========================================
# FREP Frontend Environment Variables
# ===========================================
# Copy this file to .env for local development.

# Application
VITE_APP_NAME=FREP
VITE_ZONE=dev

# Base Path (for deployments behind proxy, e.g., /pub/frep)
VITE_BASE_PATH=

# LOCAL DEV: Cognito variables not required while auth is disabled.
# VITE_USER_POOLS_ID=
# VITE_USER_POOLS_WEB_CLIENT_ID=
# VITE_REDIRECT_SIGN_OUT=http://localhost:3000

# Leave empty to route /api through the Vite dev-server proxy.
VITE_BACKEND_URL=

# Base URL for deep links to the legacy Tomcat FREP app (Accepted Sites edit).
VITE_LEGACY_APP_URL=/ext/frep

# Development Server
VITE_DEV_HOST=localhost
VITE_DEV_PORT=3000
VITE_DEV_BACKEND_TARGET=http://localhost:8080
VITE_HMR_HOST=localhost
VITE_HMR_PORT=3000
VITE_HMR_PROTOCOL=ws

NODE_ENV=development
